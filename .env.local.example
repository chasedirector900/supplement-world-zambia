# Copy to .env.local and fill in to enable the "Pay online" checkout option.
#
# Get this from the Flutterwave dashboard (Settings > API Keys). It's a
# PUBLIC key — safe to expose in the browser bundle, it can only start a
# checkout, never move money or read account data. Use a FLWPUBK_TEST-...
# key while building, swap for the live FLWPUBK-... key at go-live.
#
# Until this is set, the "Pay online" option at checkout falls back to
# asking staff to follow up with a payment link on WhatsApp instead.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
